# Copy to .env and fill in. .env is gitignored; .env.example is not -- never put
# a real key in this file.
#
# Unset, everything runs in deterministic mock mode: no key, no network, and a
# reproducible result. That is the default so a fresh clone and CI both work.

LLM_PROVIDER=mock          # mock | google | openai | groq | together | openrouter
MODEL_NAME=                # blank uses the provider default
TEMPERATURE=0.0

# Only the key for the provider above is needed.
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Bounds for a real model. Without a timeout one hung request stalls a whole run.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
