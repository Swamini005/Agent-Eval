# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Packaging / build
build/
dist/
*.egg-info/

# Environment / secrets
.env
.env.*
!.env.example

# Test & tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
pytest-report.xml

# Generated evaluation pipeline outputs.
